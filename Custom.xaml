		</Grid>
	</StackPanel>
</local:MyCard>

<local:MyCard Title="快捷启动" Margin="0,0,0,15" CanSwap="True" IsSwaped="True">
	<StackPanel Margin="24,40,24,16">
		<TextBlock TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource ColorBrush2}"
			Text="先在 PCL 中选择版本，或点「选择版本」，然后启动游戏。" />
		<Grid Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ColorBrush1}" Text="当前版本：{version}" />
			<local:MyButton Grid.Column="1" Width="100" Height="34" Text="选择版本" EventType="切换页面" EventData="5|0" ToolTip="打开 PCL 的版本选择页" />
		</Grid>
		<TextBlock Text="服务器地址（可选）" FontSize="12" Margin="2,0,0,5" Foreground="{DynamicResource ColorBrush2}"/>
		<local:MyTextBox x:Name="ServerAddressInput" Height="34" Margin="0,0,0,10" ToolTip="例如 mc.hypixel.net" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<local:MyButton Grid.Column="0" Height="34" Margin="0,0,5,0" Text="启动当前版本" EventType="启动游戏" EventData="\current" ColorType="Highlight" ToolTip="启动 PCL 当前选中的版本" />
			<local:MyButton Grid.Column="1" Height="34" Margin="5,0,0,0" Text="启动并加入服务器" EventType="启动游戏" ColorType="Highlight">
				<local:CustomEventService.EventData>
					<MultiBinding StringFormat="{}\current|{0}">
						<Binding Path="Text" ElementName="ServerAddressInput"/>
					</MultiBinding>
				</local:CustomEventService.EventData>
			</local:MyButton>
		</Grid>
		<local:MyHint Theme="Blue" Margin="0,10,0,0" Text="版本列表由 PCL 的「版本选择」页管理，这里直接启动当前选中的版本。" />
		<Border Height="1" Margin="0,14,0,10" Background="{DynamicResource ColorBrush3}" Opacity="0.5"/>
		<TextBlock Text="常用应用" FontSize="12" Margin="2,0,0,6" Foreground="{DynamicResource ColorBrush2}"/>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<local:MyButton Grid.Column="0" Height="34" Margin="0,0,5,0" Text="QQ" EventType="执行命令" EventData="explorer.exe|tencent://" ToolTip="需要已安装 QQ；首次使用请在 PCL 弹窗中允许执行" />
			<local:MyButton Grid.Column="1" Height="34" Margin="5,0,5,0" Text="微信" EventType="执行命令" EventData="explorer.exe|weixin://" ToolTip="需要已安装微信；首次使用请在 PCL 弹窗中允许执行" />
			<local:MyButton Grid.Column="2" Height="34" Margin="5,0,5,0" Text="Edge" EventType="打开文件" EventData="msedge.exe" ToolTip="需要已安装 Microsoft Edge；首次使用请在 PCL 弹窗中允许执行" />
			<local:MyButton Grid.Column="3" Height="34" Margin="5,0,0,0" Text="Chrome" EventType="打开文件" EventData="chrome.exe" ToolTip="需要已安装 Google Chrome；首次使用请在 PCL 弹窗中允许执行" />
		</Grid>
		<Border Height="1" Margin="0,14,0,10" Background="{DynamicResource ColorBrush3}" Opacity="0.5"/>
		<TextBlock Text="基岩版" FontSize="12" Margin="2,0,0,2" Foreground="{DynamicResource ColorBrush2}"/>
		<local:MyListItem Margin="-4,2,-4,0" Logo="pack://application:,,,/images/Blocks/Grass.png"
			Title="启动 Minecraft Bedrock" Info="需要已安装基岩版；无法打开时请检查系统关联" EventType="打开网页" EventData="minecraft://" Type="Clickable" />
	</StackPanel>
