<local:MyCard Title="快捷工具" Margin="0,0,0,15" CanSwap="True" IsSwaped="True">
	<StackPanel Margin="24,40,24,16">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<local:MyButton Grid.Column="0" Height="34" Margin="0,0,5,0" Text="今日人品" EventType="今日人品" ToolTip="看看今天的 Minecraft 人品值。" />
			<local:MyButton Grid.Column="1" Height="34" Margin="5,0,5,0" Text="清理垃圾" EventType="清理垃圾" ColorType="Red" ToolTip="清理 PCL 缓存与 MC 日志，请先备份需要的日志。" />
			<local:MyButton Grid.Column="2" Height="34" Margin="5,0,0,0" Text="检查更新" EventType="检查更新" ToolTip="检查 PCL 是否有新版本。" />
		</Grid>
		<Grid Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<local:MyButton Grid.Column="0" Height="34" Margin="0,0,5,0" Text="打开 PCL 目录" EventType="打开文件" EventData="{path}" ToolTip="打开 PCL 所在文件夹。" />
			<local:MyButton Grid.Column="1" Height="34" Margin="5,0,0,0" Text="查看最新日志" EventType="打开文件" EventData="{path}PCL\Log1.txt" ToolTip="打开 PCL 的当前日志，便于反馈问题。" />
		</Grid>
		<local:MyHint Theme="Yellow" Margin="0,10,0,0" Text="「清理垃圾」会删除缓存与日志，操作前请确认没有需要保留的内容。" />
		<Border Height="1" Margin="0,14,0,10" Background="{DynamicResource ColorBrush3}" Opacity="0.5"/>
		<TextBlock Text="Minecraft 服务器状态" FontSize="13.5" Margin="2,0,0,2" Foreground="{DynamicResource ColorBrush1}"/>
		<TextBlock TextWrapping="Wrap" FontSize="11" Margin="2,0,0,8" Foreground="{DynamicResource ColorBrush2}"
			Text="输入服务器地址后自动查询；只填域名，不要带端口。状态图由 MineBBS MOTD 提供。" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="110"/>
			</Grid.ColumnDefinitions>
			<local:MyTextBox x:Name="PingHost" Grid.Column="0" Height="34" Margin="0,0,8,0" Text="play.easecation.net" HintText="服务器地址，如 mc.hypixel.net" ToolTip="只填域名，不要带端口" />
			<local:MyTextBox x:Name="PingPort" Grid.Column="1" Height="34" HintText="端口（可选）" ToolTip="留空自动识别 Java / 基岩版默认端口" />
		</Grid>
		<local:MyImage Margin="0,10,0,0" Width="360" Height="202" Stretch="Uniform" EnableCache="False" HorizontalAlignment="Center">
			<local:MyImage.Source>
				<MultiBinding StringFormat="https://motd.minebbs.com/api/status_img?ip={0}&amp;port={1}&amp;theme=simple">
					<Binding Path="Text" ElementName="PingHost" Delay="800"/>
					<Binding Path="Text" ElementName="PingPort" Delay="800"/>
				</MultiBinding>
			</local:MyImage.Source>
		</local:MyImage>
		<Grid Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<local:MyButton Grid.Column="0" Height="34" Margin="0,0,5,0" Text="浏览器打开" EventType="打开网页" ToolTip="在浏览器中打开状态图">
				<local:CustomEventService.EventData>
					<MultiBinding StringFormat="https://motd.minebbs.com/api/status_img?ip={0}&amp;port={1}&amp;theme=simple">
						<Binding Path="Text" ElementName="PingHost"/>
						<Binding Path="Text" ElementName="PingPort"/>
					</MultiBinding>
				</local:CustomEventService.EventData>
			</local:MyButton>
			<local:MyButton Grid.Column="1" Height="34" Margin="5,0,5,0" Text="复制链接" EventType="复制文本" ToolTip="复制状态图链接">
				<local:CustomEventService.EventData>
					<MultiBinding StringFormat="https://motd.minebbs.com/api/status_img?ip={0}&amp;port={1}&amp;theme=simple">
						<Binding Path="Text" ElementName="PingHost"/>
						<Binding Path="Text" ElementName="PingPort"/>
					</MultiBinding>
				</local:CustomEventService.EventData>
			</local:MyButton>
			<local:MyButton Grid.Column="2" Height="34" Margin="5,0,0,0" Text="打开 MOTD 站" EventType="打开网页" EventData="https://motd.minebbs.com/" />
		</Grid>
	</StackPanel>
</local:MyCard>

