<local:MyCard Title="回声洞" Margin="0,0,0,15" CanSwap="True" IsSwaped="False">
	<StackPanel Margin="24,40,24,14">
		<Grid Margin="4,2,4,0">
			<TextBlock TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center" MaxWidth="700" TextAlignment="Center" Text="{cave}" FontSize="13.5" LineHeight="22" Foreground="{DynamicResource ColorBrush1}">
				<TextBlock.Clip>
					<RectangleGeometry Rect="0,0,1000,1000"/>
				</TextBlock.Clip>
				<TextBlock.Triggers>
					<EventTrigger RoutedEvent="Loaded">
						<BeginStoryboard>
							<Storyboard>
								<RectAnimation Storyboard.TargetProperty="Clip.Rect" From="0,0,0,1000" To="0,0,720,1000" Duration="0:0:3.2"/>
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>
				</TextBlock.Triggers>
			</TextBlock>
			<local:MyButton Opacity="0" FocusVisualStyle="{x:Null}" Cursor="Hand" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" MinHeight="0" Padding="0"
				EventType="刷新主页" EventData="回声洞" ToolTip="点击换一条回声洞" />
		</Grid>
		<local:MyTextButton HorizontalAlignment="Right" Margin="0,6,0,0" Text="投稿" EventType="打开网页" EventData="https://jinshuju.net/f/esXHQF" ToolTip="向 PCL 投稿回声洞" />
	</StackPanel>
</local:MyCard>

<local:MyCard Title="快速搜索" Margin="0,0,0,15" CanSwap="True" IsSwaped="False">
	<StackPanel Margin="24,40,24,16">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="88"/>
			</Grid.ColumnDefinitions>
			<local:MyComboBox x:Name="EngineBox" Grid.Column="0" Height="34" Margin="0,0,8,0" SelectedIndex="0" ToolTip="选择搜索引擎">
				<local:MyComboBoxItem Content="百度" Tag="https://www.baidu.com/s?wd="/>
				<local:MyComboBoxItem Content="必应" Tag="https://cn.bing.com/search?q="/>
				<local:MyComboBoxItem Content="谷歌" Tag="https://www.google.com/search?q="/>
				<local:MyComboBoxItem Content="搜狗" Tag="https://www.sogou.com/web?query="/>
				<local:MyComboBoxItem Content="MC百科" Tag="https://search.mcmod.cn/s?key="/>
				<local:MyComboBoxItem Content="MC Wiki" Tag="https://zh.minecraft.wiki/?search="/>
				<local:MyComboBoxItem Content="Bilibili" Tag="https://search.bilibili.com/all?keyword="/>
				<local:MyComboBoxItem Content="GitHub" Tag="https://github.com/search?q="/>
				<local:MyComboBoxItem Content="Modrinth" Tag="https://modrinth.com/mods?q="/>
				<local:MyComboBoxItem Content="CurseForge" Tag="https://www.curseforge.com/minecraft/search?search="/>
				<local:MyComboBoxItem Content="Seed Map" Tag="https://www.chunkbase.com/apps/seed-map#seed="/>
			</local:MyComboBox>
			<local:MyTextBox x:Name="SearchInput" Grid.Column="1" Height="34" Margin="0,0,8,0" HintText="输入搜索内容……" ToolTip="输入关键词，不支持回车，请点击右侧按钮。" />
			<local:MyButton Grid.Column="2" Height="34" Text="搜索" ColorType="Highlight" EventType="打开网页" ToolTip="打开网页搜索关键词">
				<local:CustomEventService.EventData>
					<MultiBinding StringFormat="{}{0}{1}">
						<Binding Path="SelectedItem.Tag" ElementName="EngineBox"/>
						<Binding Path="Text" ElementName="SearchInput"/>
					</MultiBinding>
				</local:CustomEventService.EventData>
			</local:MyButton>
		</Grid>
		<TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource ColorBrush2}"
			Text="提示：Seed Map 请直接输入种子；搜索词中的空格与符号会由浏览器自动编码。" />
	</StackPanel>
</local:MyCard>

